# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (CORS allowlist)
CORS_ORIGINS=http://localhost:3000
# Per-client requests per minute (global default; chat endpoints are stricter)
RATE_LIMIT_PER_MINUTE=60

# ── Database (PostgreSQL) ─────────────────────────────────
# Cloud (Neon):  postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local, no Docker: run `pnpm --filter @healtrip/api db:local` and paste the printed URL
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable

# ── LLM provider: anthropic | openai | mock ───────────────
# `mock` = offline demo brain (no API key; the tools, triage, grounding and DB are all real).
# For Claude: LLM_PROVIDER=anthropic and set ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Reasoning depth: low | medium | high | xhigh | max (set explicitly; Opus 5.5 defaults to medium)
LLM_EFFORT=medium
# Per-request timeout (ms) and SDK retries for 408/409/429/5xx/connection errors
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=16000
# Daily token cap for the paid model (0 = unlimited); past it the demo brain answers until 00:00 UTC
LLM_DAILY_TOKEN_BUDGET=0

# ── Agent loop limits (per patient message) ───────────────
AGENT_MAX_ITERATIONS=6
AGENT_TURN_BUDGET_MS=90000

# ── Chat ──────────────────────────────────────────────────
# Messages per client per minute (each message triggers LLM calls)
CHAT_RATE_LIMIT_PER_MINUTE=10
# Max patient messages per conversation, and earlier turns sent to the model as context
CHAT_MAX_TURNS=30
CHAT_HISTORY_TURNS=10
