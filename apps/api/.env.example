# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (CORS allowlist)
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ─────────────────────────────────
# Cloud (Neon):  postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local, no Docker: run `pnpm --filter @healtrip/api db:local` and paste the printed URL
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable

# ── LLM provider: anthropic | openai | mock ───────────────
# `mock` needs no API key (scripted agent used by tests / keyless demo)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
